# ============================================================
# MuyunMiaoAI（沐云杪AI）· 全局 .gitignore
# 作用：防止敏感文件（密钥/环境变量/配置）与构建产物被误提交到 GitHub
# 说明：每个忽略项都附中文注释，说明用途，便于维护
# ============================================================

# ---------- 一、系统与 IDE 文件 ----------
.DS_Store              # macOS 的文件夹元数据文件，无意义，不应入库
Thumbs.db              # Windows 缩略图缓存文件，本地生成
desktop.ini            # Windows 文件夹自定义文件，本地生成
*.swp                  # Vim 交换文件（编辑器崩溃残留，可能含未保存内容）
*.swo                  # Vim 交换文件（第二份）
*~                     # 编辑器自动备份文件（gedit/emacs 等）
.idea/                 # IntelliJ IDEA / Android Studio 工程配置（含本机设置，不应共享）
*.iml                  # IntelliJ 模块描述文件（由 IDE 自动生成）
.vscode/               # VS Code 本地配置（含个人设置）

# ---------- 二、环境变量与密钥配置（核心防护） ----------
.env                   # 环境变量主文件（可能含 API Key / Token / 口令，禁止提交）
.env.*                 # 环境变量变体（如 .env.local、.env.production、.env.dev）
!.env.example          # 例外：环境变量示例模板允许提交（只含占位符，无真实密钥）
config/secret          # 敏感配置目录（密钥/口令）
config/secrets/        # 敏感配置目录（变体）
secrets/               # 根级密钥目录
credentials/           # 凭据目录
*.properties           # 属性文件（可能含密码；如需模板请用 *.example）
!gradle.properties     # 例外：Gradle 全局构建配置（本项目需要提交）
!gradle-wrapper.properties  # 例外：Gradle Wrapper 版本定义（本项目需要提交）
application.properties # Spring 等框架默认配置（常含数据库口令）
application.yml        # 同上（YAML 版本）
application.yaml       # 同上（变体）
application-local.*    # 本地专用配置（含个人环境信息）

# ---------- 三、密钥与证书文件（防止误提交，最高优先级） ----------
*.key                  # 私钥文件（RSA/EC 等非对称私钥）
*.pem                  # PEM 格式密钥/证书（可能含 "PRIVATE KEY" 片段）
*.crt                  # 证书文件（虽多为公钥，但常与私钥成对出现）
*.cer                  # 证书文件（变体）
*.p12                  # PKCS#12 密钥库（含私钥，常用于应用签名）
*.pfx                  # PKCS#12 密钥库（Windows 变体）
*.jks                  # Java KeyStore（含私钥，如 JWT 签名/HTTPS 用）
*.keystore             # Android/Java 密钥库（应用签名用，泄露可被冒签）
*.p8                   # PKCS#8 私钥
*.p8e                  # 加密的 PKCS#8 私钥
*.asc                  # PGP 密钥/签名（可能含私钥）
*.gpg                  # GnuPG 密钥环
*.pub                  # 公钥（公开，但避免与私钥成对误传）
id_rsa                 # SSH 私钥（RSA）
id_ed25519             # SSH 私钥（Ed25519）
id_ecdsa               # SSH 私钥（ECDSA）
*.ppk                  # PuTTY 私钥
!debug.keystore        # 例外：Android 调试签名库（公开无风险，可提交）

# ---------- 四、构建产物与依赖缓存 ----------
build/                 # Gradle 构建输出目录（各模块）
.gradle/               # Gradle 缓存与任务历史
.kotlin/               # Kotlin 编译缓存
.cxx/                  # CMake 原生构建缓存
.externalNativeBuild/  # Android 原生构建输出
captures/              # Android Profiler 抓取数据（含运行数据）
output-metadata.json   # 构建元数据（自动生成）
*.apk                  # 安装包（构建产物）
*.aab                  # App Bundle（构建产物）
*.hprof                # 内存堆转储（可能含敏感数据，严禁提交）
node_modules/          # npm 依赖（如涉及 web 子工程）
.pnpm-store/           # pnpm 依赖缓存

# ---------- 五、本地环境与 SDK 配置 ----------
local.properties       # Android SDK 路径（本机绝对路径，含个人信息，严禁提交）
*.local                # 本地覆盖配置

# ---------- 六、日志与临时文件 ----------
*.log                  # 日志文件（可能泄露路径/密钥）
logs/                  # 日志目录
log/                   # 日志目录（变体）
*.tmp                  # 临时文件
*.temp                 # 临时文件（变体）
*.bak                  # 备份文件
*.orig                 # 合并冲突备份
*.rej                  # 补丁拒绝记录

# ---------- 七、数据库与数据快照 ----------
*.db                   # 数据库文件（可能含用户数据）
*.db-journal           # SQLite 日志
*.sqlite               # SQLite 数据库
*.sqlite3              # SQLite 数据库
*.mdb                  # Access 数据库
*.dump                 # 数据库转储

# ---------- 八、AI 模型文件（体积大、易含数据，一律不入库） ----------
models/*.mnn           # MNN 量化模型（按需下载，不提交）
models/*.gguf          # GGUF 模型文件（体积大）
models/*.bin           # 模型权重文件
*.onnx                 # ONNX 模型
*.tflite               # TFLite 模型
*.safetensors          # HuggingFace 权重格式
*.ckpt                 # 训练检查点
*.pt                   # PyTorch 权重

# ---------- 九、测试与覆盖率产物 ----------
coverage/              # 覆盖率报告目录
*.lcov                 # 覆盖率数据
allure-results/        # 测试报告产物
.nyc_output/           # Node 覆盖率输出

# ---------- 十、其他 ----------
*.psd                  # 设计源文件（体积大，按需入库）
.gitattributes-local   # 本机 git 属性覆盖

# ============================================================
# MuyunMiaoAI（沐云杪AI）· 全局 .gitignore
# 作用：防止敏感文件（密钥/环境变量/配置）与构建产物被误提交到 GitHub
# 重要：git 的 .gitignore 只认行首 # 为注释，行内 # 会被当成模式一部分
#       因此所有注释必须独占一行（本文件已修正此问题）
# ============================================================

# ---------- 一、系统与 IDE 文件 ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/

# ---------- 二、环境变量与密钥配置（核心防护） ----------
.env
.env.*
!.env.example
config/secret
config/secrets/
secrets/
credentials/
*.properties
!gradle.properties
!gradle-wrapper.properties
application.properties
application.yml
application.yaml
application-local.*

# ---------- 三、密钥与证书文件（防止误提交，最高优先级） ----------
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.p8
*.p8e
*.asc
*.gpg
*.pub
id_rsa
id_ed25519
id_ecdsa
*.ppk
!debug.keystore

# ---------- 四、构建产物与依赖缓存 ----------
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
output-metadata.json
*.apk
*.aab
*.hprof
node_modules/
.pnpm-store/

# ---------- 五、本地环境与 SDK 配置 ----------
local.properties
*.local

# ---------- 六、日志与临时文件 ----------
*.log
logs/
log/
*.tmp
*.temp
*.bak
*.orig
*.rej

# ---------- 七、数据库与数据快照 ----------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.mdb
*.dump

# ---------- 八、AI 模型文件（体积大、易含数据，一律不入库） ----------
models/*.mnn
models/*.gguf
models/*.bin
*.onnx
*.tflite
*.safetensors
*.ckpt
*.pt

# ---------- 九、测试与覆盖率产物 ----------
coverage/
*.lcov
allure-results/
.nyc_output/

# ---------- 十、其他 ----------
*.psd
.gitattributes-local
